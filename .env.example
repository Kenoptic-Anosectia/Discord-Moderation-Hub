# Discord bot token
DISCORD_TOKEN=your_bot_token_here

# Core IDs
LOG_CHANNEL_ID=123456789012345678
AGE_ROLE_1=123456789012345678
AGE_ROLE_2=123456789012345678

# Optional database path
REACTION_ROLE_DB_PATH=reaction_roles.sqlite

# Required for /age-verified: the invoking member must hold this guild role.
# Missing/invalid STAFF_ROLE_ID disables only that command. Use a real staff
# role distinct from AGE_ROLE_1, AGE_ROLE_2 and the guild's @everyone role.
STAFF_ROLE_ID=123456789012345678

# Optional ticket system IDs
TICKET_CATEGORY_ID=123456789012345678
AGE_VERIFICATION_CATEGORY_ID=123456789012345678