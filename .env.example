# Discord bot token
DISCORD_TOKEN=your_bot_token_here

# Core IDs
LOG_CHANNEL_ID=123456789012345678
AGE_ROLE_1=123456789012345678
AGE_ROLE_2=123456789012345678

# Optional database path
REACTION_ROLE_DB_PATH=reaction_roles.sqlite

# Required for /age-verified: the invoking member must hold this guild role.
# Missing/invalid STAFF_ROLE_ID disables only that command. Use a real staff
# role distinct from AGE_ROLE_1, AGE_ROLE_2 and the guild's @everyone role.
STAFF_ROLE_ID=123456789012345678

# Ticket system (non-secret). OFF by default; everything below is ignored unless
# TICKETS_ENABLED=true. Opening tickets stays hard-gated in code until A07
# (privacy completion) and audited recovery land; see
# docs/verification/TICKET-CREATION.md. Uses STAFF_ROLE_ID above as ticket staff.
TICKETS_ENABLED=false
TICKET_GUILD_ID=123456789012345678
TICKET_CATEGORY_ID=123456789012345678
AGE_VERIFICATION_CATEGORY_ID=123456789012345678
# Separate SQLite file, created only when enabled (never reaction_roles.sqlite).
TICKET_DB_PATH=tickets.sqlite
# Archive retention dry run only; this setting never authorizes deletion.
# Unset, empty or whitespace = off; otherwise ASCII digits, 1–36500 days
# (whitespace trimmed). Read only when TICKETS_ENABLED=true, where an
# invalid value disables ticket settings (startup names this key, not the value).
TICKET_ARCHIVE_RETENTION_DAYS=

# Core settings for the optional feature layer (non-secret). Everything below is
# OFF/empty unless you set it. No feature uses them yet; only the guild filter
# (feature dispatch) and the log exclusions (the logger) act on them today.
# Shared SQLite file for new features. Default: core.sqlite. The file is created
# only when an enabled feature needs it. A bad value (control characters, a
# file: URI, :memory:, too long) turns the core database off and startup names
# this key, never the value. It must not be the ticket or reaction-role file.
CORE_DB_PATH=core.sqlite
# Optional: serve only this guild in feature dispatch (one Discord id). Unset =
# every guild. A bad value closes feature dispatch and startup names this key.
# GUILD_ID=123456789012345678
# Optional: channel for staff alerts (one Discord id). Unset = no alerts. A bad
# value switches alerts off and startup names this key. Nothing posts alerts yet.
# STAFF_ALERT_CHANNEL_ID=123456789012345678
# Comma-separated Discord ids. Messages in these channels (and their threads)
# are never cached or logged on edit/delete. Default: empty. A bad entry makes
# the whole list unusable: guild message caching and edit/delete logging pause
# until it is fixed, and startup names this key.
# LOG_EXCLUDED_CHANNEL_IDS=123456789012345678,123456789012345679
# Same, for categories: every channel and thread under them is excluded.
# LOG_EXCLUDED_CATEGORY_IDS=123456789012345678
# Comma-separated role ids that automated paths must never grant. Default:
# empty. A bad entry switches the list off and startup names this key. Read by
# the safeword and reaction-role features (when on) and later cards; a bad list
# makes the safeword refuse to start.
# PROTECTED_ROLE_IDS=123456789012345678

# Optional features wired by W2 (docs/verification/WIRING-B.md). Every feature is OFF
# unless its *_MODE key is set to shadow or live; leave the lines commented to keep
# it off. Each feature also needs GUILD_ID above: with a mode on and no usable GUILD_ID the
# feature stays off and startup prints a stable code. A refused value names only the KEY.
# Flash media: FLASH_MODE=off (default) | shadow (counts only, deletes nothing) | live
# (deletes the media and the bot notice after the delay). Live uses the core database and the
# job runner. While flash is on its channels are added to the log exclusions.
# FLASH_MODE=off
# Comma-separated channel ids where flashed media expires. Empty = the feature does nothing.
# FLASH_CHANNEL_IDS=123456789012345678,123456789012345679
# Optional: one role id to mention in the notice. Unset = no mention.
# FLASH_PING_ROLE_ID=123456789012345678
# Seconds before the media is deleted: 10 to 86400. Default 180.
# FLASH_DELAY_SECS=180
# Also expire media in threads of those channels: true (default) or false.
# FLASH_INCLUDE_THREADS=true
# Safeword: SAFEWORD_MODE=off (default) | shadow (records what it would do) | live. When on, the
# ids below are all required, and /safeword (status, strike, clear) is added to the command
# list. strike and clear need STAFF_ROLE_ID above; PROTECTED_ROLE_IDS must be readable. Uses
# the core database. STAFF_ALERT_CHANNEL_ID above receives alerts (codes only).
# SAFEWORD_MODE=off
# SAFEWORD_ROLE_ID=123456789012345678
# SAFEWORD_CHANNEL_ID=123456789012345678
# SAFEWORD_MESSAGE_ID=123456789012345678
# SAFEWORD_EMOJI_ID=123456789012345678
# Comma-separated roles the safeword takes away. One bad entry refuses the whole feature.
# SAFEWORD_RESTRICTED_ROLE_IDS=123456789012345678,123456789012345679
# Send the activation and release DMs: on (default) or off. Anything else refuses the feature.
# SAFEWORD_DM=on
# Defer roles granted during a safeword until it ends: on (default) or off.
# SAFEWORD_DEFER_GRANTS=on
# Reaction roles on the shared role service: REACTION_ROLES_MODE=off (default) | live.
# While it is off the existing reaction handlers in main.rs run exactly as before. When live,
# it replaces them: the old handlers do nothing and the new path uses the same reaction_roles
# table (REACTION_ROLE_DB_PATH). shadow is refused. Uses PROTECTED_ROLE_IDS and, while the
# safeword is on, SAFEWORD_RESTRICTED_ROLE_IDS; if SAFEWORD_MODE is on but the safeword cannot
# start, reaction roles stay off too and the old handlers keep running. Live serves only the
# GUILD_ID guild (the old handlers serve every guild), so other guilds get no reaction roles.
# REACTION_ROLES_MODE=off

# Welcome (W3a, docs/verification/WIRING-C1.md). WELCOME_MODE=off (default) | shadow (records
# what it would do; grants and posts nothing) | live. When on it needs GUILD_ID above (the home
# guild; unset = the feature stays off with home_guild_missing), the core database and the job
# runner, and a template file named below. On a member join (never a bot account) it grants
# JOIN_ROLE_IDS and posts the welcome in WELCOME_CHANNEL_ID, in the GUILD_ID guild only. Staff
# alerts (codes only, one per code per 5 minutes) go to STAFF_ALERT_CHANNEL_ID above. A refused
# value names only the KEY. A join role that is privileged, protected, managed, @everyone, at or
# above the bot's top role, or deleted keeps welcome off (key JOIN_ROLE_IDS plus a stable code).
# WELCOME_MODE=off
# Channel the welcome is posted in (one Discord id). Required when the mode is on.
# WELCOME_CHANNEL_ID=123456789012345678
# Template name: lower-case letters, digits, - and _ only (no path, no extension). The file is
# welcome_templates/<name>.json next to the bot, at most 64 KiB. Required when the mode is on.
# WELCOME_TEMPLATE_PATH=welcome
# Comma-separated role ids granted to a joining member. Default: empty (the message only).
# JOIN_ROLE_IDS=123456789012345678
# Startup preflight (no key of its own): when flash, safeword or welcome is on, the bot's real
# permissions in the target channels and its role positions are checked before that feature
# starts. A feature that fails stays off and startup prints its name and stable reason codes
# (never an id or a value). With every *_MODE key off nothing is checked and nothing is printed.
